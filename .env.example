DATABASE_URL=postgresql://postgres:password@localhost:5432/tutor_app

# Optional. Overrides the Postgres password used by docker-compose; without it
# compose falls back to the value the existing pgdata volume was created with.
# Note that Postgres only applies this when initialising an EMPTY data directory,
# so changing it on a live database also needs an ALTER USER.
# POSTGRES_PASSWORD=

# Public URL of the app. Read at BUILD time (Next.js inlines NEXT_PUBLIC_*),
# so docker-compose passes it through to the image as a build arg.
NEXT_PUBLIC_APP_URL=https://your-domain.example

AUTH_SECRET=your-secret-here
AUTH_TRUST_HOST=true

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is also inlined at build time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:your-email@example.com
